---
import Layout from '../layouts/Layout.astro';
import DogList from '../components/DogList.astro';

const API_SERVER_URL = process.env.API_SERVER_URL || 'http://localhost:5100';
const PAGE_SIZE = 6;

let dogs = [];
let page = 1;
let totalPages = 1;
let error: string | null = null;

const currentPage = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);

const STATUS_OPTIONS = ['ALL', 'AVAILABLE', 'ADOPTED', 'PENDING'];
const requestedStatus = Astro.url.searchParams.get('status') ?? 'ALL';
const currentStatus = STATUS_OPTIONS.includes(requestedStatus) ? requestedStatus : 'ALL';

// Carry the active status through pagination links.
const pageHref = (targetPage: number) =>
  currentStatus === 'ALL' ? `/?page=${targetPage}` : `/?page=${targetPage}&status=${currentStatus}`;

try {
  const response = await fetch(`${API_SERVER_URL}/api/dogs?page=${currentPage}&per_page=${PAGE_SIZE}&status=${currentStatus}`);
  if (response.ok) {
    const data = await response.json();
    dogs = data.dogs;
    page = data.page;
    totalPages = data.total_pages;
  } else {
    error = `Failed to fetch data: ${response.status} ${response.statusText}`;
  }
} catch (err) {
  error = `Error: ${err instanceof Error ? err.message : String(err)}`;
}
---

<Layout title="Tailspin Shelter - Find Your Forever Friend">
  <div class="py-8">
    <div class="max-w-3xl mb-10">
      <h1 class="text-4xl font-bold mb-4 text-slate-100">Welcome to Tailspin Shelter</h1>
      <p class="text-xl text-slate-300">Find your perfect companion from our wonderful selection of dogs looking for their forever homes.</p>
    </div>

    {error ? (
      <div class="text-center py-12 bg-slate-800/50 backdrop-blur-sm rounded-xl border border-slate-700" data-testid="error-message">
        <p class="text-red-400">{error}</p>
      </div>
    ) : (
      <>
        <form method="get" class="mb-8 flex items-center gap-3" data-testid="status-filter-form">
          <label for="status" class="text-slate-300 text-sm font-medium">Adoption status</label>
          <select
            id="status"
            name="status"
            class="bg-slate-800 border border-slate-700 text-slate-200 rounded-lg px-3 py-2 text-sm focus:border-blue-500/60 focus:outline-none"
            data-testid="status-filter"
          >
            {STATUS_OPTIONS.map((option) => (
              <option value={option} selected={option === currentStatus}>
                {option === 'ALL' ? 'All' : option.charAt(0) + option.slice(1).toLowerCase()}
              </option>
            ))}
          </select>
          <button
            type="submit"
            class="px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-300 text-sm hover:border-blue-500/50 hover:text-blue-400 transition-colors"
            data-testid="status-filter-apply"
          >
            Apply
          </button>
        </form>

        <DogList dogs={dogs} />

        {totalPages > 1 && (
          <nav class="flex justify-center items-center gap-2 mt-10" data-testid="pagination">
            {page > 1 ? (
              <a
                href={pageHref(page - 1)}
                class="px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-300 hover:border-blue-500/50 hover:text-blue-400 transition-colors"
                data-testid="pagination-prev"
              >
                ← Previous
              </a>
            ) : (
              <span class="px-4 py-2 rounded-lg bg-slate-800/50 border border-slate-700/50 text-slate-600 cursor-not-allowed">
                ← Previous
              </span>
            )}

            <span class="px-4 py-2 text-slate-300" data-testid="pagination-info">
              Page {page} of {totalPages}
            </span>

            {page < totalPages ? (
              <a
                href={pageHref(page + 1)}
                class="px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-300 hover:border-blue-500/50 hover:text-blue-400 transition-colors"
                data-testid="pagination-next"
              >
                Next →
              </a>
            ) : (
              <span class="px-4 py-2 rounded-lg bg-slate-800/50 border border-slate-700/50 text-slate-600 cursor-not-allowed">
                Next →
              </span>
            )}
          </nav>
        )}
      </>
    )}
  </div>
</Layout>
